{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true
  },
  "include": [
    "index.ts",
    "ensureHexFormat.ts",
    "lighten/index.ts",
    "darken/index.ts",
    "desaturate/index.ts",
    "saturate/index.ts",
    "test/*.ts"
  ]
}
